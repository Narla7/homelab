# BookOrbit — copy to ~/bookorbit/.env, fill in, chmod 600.

# required
APP_IMAGE=ghcr.io/bookorbit/bookorbit:latest
APP_URL=http://<tailnet-ip>:3001
JWT_SECRET=change-me
SETUP_BOOTSTRAP_TOKEN=change-me

# database (container-internal postgres)
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=change-me
DB_DATA_LOCATION=./pgdata

# defaults are usually fine
APP_PORT=3000
PUID=1000
PGID=1000
TZ=UTC

# libraries bind-mounted into the app (adjust to your paths)
BOOKS_HOST_PATH=./books
# BOOK_DOCK_PATH=
# LIBRARY_BROWSE_ROOT=

# read-aloud worker (private compose network)
# READ_ALOUD_WORKER_URL=
# READ_ALOUD_WORKER_TOKEN=
