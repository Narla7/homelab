# Immich — copy to ~/immich/.env, fill in, chmod 600.
# Real setup generates .env from ~/immich/.dbpassword (never committed).

# where photo libraries live on the host
UPLOAD_LOCATION=/mnt/immich
# where the postgres data dir lives on the host
DB_DATA_LOCATION=./pgdata

# database credentials (all three must match)
DB_PASSWORD=change-me
POSTGRES_USER=change-me
POSTGRES_DB=change-me
